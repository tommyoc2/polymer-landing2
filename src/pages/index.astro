---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Polymer — The Verifiable RPC Network"
  description="Polymer is the Verifiable RPC Network. Every response is signed inside a tamper-proof hardware enclave so the operator can stall traffic, but can't fake the answer."
  currentPage="protocol"
>

<!-- ============ HERO ============ -->
<section class="hero">
  <canvas id="chrome-bg"></canvas>
  <div class="eyebrow">
    <span>POLYMER <span class="v">/ The Verifiable RPC Network</span></span>
  </div>

  <h1 class="htitle">
    <span class="silver">Verifying the</span><br/>
    <span class="blue">Onchain Economy.</span>
  </h1>

  <p class="lede">
    Every wallet, bridge, and exchange reads the blockchain through someone
    else's server, and trusts whatever it says. Polymer signs every response
    inside <strong>tamper-proof hardware</strong>.
  </p>

  <div class="cta">
    <a class="btn btn-primary" href="#">Read the whitepaper</a>
  </div>

  <hr class="section-divider"/>
  <div class="marker" id="architecture">01 // PROTOCOL ARCHITECTURE</div>

  <!-- DIE-SHOT VISUAL -->
  <div class="die">
    <div class="die-frame">

      <!-- Left side meta rows -->
      <div class="die-side">
        <div class="row">
          <div class="lbl">Hardware</div>
          <div class="val">Intel TDX <span class="a">·</span> sealed RAM</div>
        </div>
        <div class="row">
          <div class="lbl">Image digest</div>
          <div class="val">sha256:<span class="a">7f3c8b…d92c</span></div>
        </div>
        <div class="row live">
          <div class="lbl">Boot identity</div>
          <div class="val">I_priv_n <span class="a">·</span> ephemeral</div>
        </div>
        <div class="row">
          <div class="lbl">Lifetime</div>
          <div class="val">RAM-only · vanishes on reboot</div>
        </div>
      </div>

      <!-- Center: chip die -->
      <div class="die-chip">
        <div class="chip-grid"></div>
        <div class="chip-rim"></div>
        <span class="corner tl"></span>
        <span class="corner tr"></span>
        <span class="corner bl"></span>
        <span class="corner br"></span>

        <div class="die-chip-label">
          <span class="tag">TDX ENCLAVE · CHAIN FULL NODE</span>
          <span class="id">node:0x4a8f2c1b…e92c</span>
        </div>

        <div class="die-svg-wrap">
          <svg viewBox="0 0 600 230" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="silver" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#F1F4F9"/>
                <stop offset="50%" stop-color="#B3B9C2"/>
                <stop offset="100%" stop-color="#6F7682"/>
              </linearGradient>
              <linearGradient id="diegrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#1A1F2A"/>
                <stop offset="100%" stop-color="#0A0D14"/>
              </linearGradient>
              <radialGradient id="core" cx="0.5" cy="0.5">
                <stop offset="0%" stop-color="#4FA3FF" stop-opacity="0.5"/>
                <stop offset="100%" stop-color="#4FA3FF" stop-opacity="0"/>
              </radialGradient>
            </defs>

            <!-- Outer chip body (silver bezel) -->
            <rect x="40" y="20" width="520" height="190" rx="6" fill="url(#silver)" opacity="0.15"/>
            <rect x="42" y="22" width="516" height="186" rx="5" fill="url(#diegrad)" stroke="#4FA3FF" stroke-opacity="0.6"/>

            <!-- Pin grid top -->
            <g class="pin-row pin-top" fill="#4FA3FF">
              <circle cx="80"  cy="14" r="2"/><circle cx="100" cy="14" r="2"/><circle cx="120" cy="14" r="2"/>
              <circle cx="140" cy="14" r="2"/><circle cx="160" cy="14" r="2"/><circle cx="180" cy="14" r="2"/>
              <circle cx="200" cy="14" r="2"/><circle cx="220" cy="14" r="2"/><circle cx="240" cy="14" r="2"/>
              <circle cx="260" cy="14" r="2"/><circle cx="300" cy="14" r="2"/><circle cx="340" cy="14" r="2"/>
              <circle cx="380" cy="14" r="2"/><circle cx="420" cy="14" r="2"/><circle cx="460" cy="14" r="2"/>
              <circle cx="480" cy="14" r="2"/><circle cx="500" cy="14" r="2"/><circle cx="520" cy="14" r="2"/>
            </g>
            <g class="pin-row pin-bot" fill="#4FA3FF">
              <circle cx="80"  cy="216" r="2"/><circle cx="100" cy="216" r="2"/><circle cx="120" cy="216" r="2"/>
              <circle cx="140" cy="216" r="2"/><circle cx="160" cy="216" r="2"/><circle cx="180" cy="216" r="2"/>
              <circle cx="200" cy="216" r="2"/><circle cx="220" cy="216" r="2"/><circle cx="240" cy="216" r="2"/>
              <circle cx="260" cy="216" r="2"/><circle cx="300" cy="216" r="2"/><circle cx="340" cy="216" r="2"/>
              <circle cx="380" cy="216" r="2"/><circle cx="420" cy="216" r="2"/><circle cx="460" cy="216" r="2"/>
              <circle cx="480" cy="216" r="2"/><circle cx="500" cy="216" r="2"/><circle cx="520" cy="216" r="2"/>
            </g>

            <!-- Glow halo around core -->
            <ellipse cx="300" cy="115" rx="180" ry="80" fill="url(#core)"/>

            <!-- Inner functional units -->
            <!-- left block: workload -->
            <g>
              <rect x="62" y="46" width="160" height="54" fill="none" stroke="#2C3038" stroke-width="1"/>
              <text x="70" y="62" font-family="JetBrains Mono" font-size="9" fill="#4FA3FF" letter-spacing="1">CHAIN FULL NODE</text>
              <line x1="70" y1="68" x2="160" y2="68" stroke="#4FA3FF"/>
              <text x="70" y="82" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A">EL + CL · RPC server</text>
              <text x="70" y="93" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A">canonical answer</text>

              <rect x="62" y="110" width="160" height="54" fill="none" stroke="#2C3038" stroke-width="1"/>
              <text x="70" y="126" font-family="JetBrains Mono" font-size="9" fill="#4FA3FF" letter-spacing="1">EIP-712</text>
              <line x1="70" y1="132" x2="120" y2="132" stroke="#4FA3FF"/>
              <text x="70" y="146" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A">PolymerResponse</text>
              <text x="70" y="157" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A">typed-data digest</text>
            </g>

            <!-- centre: signing core -->
            <g>
              <rect x="240" y="62" width="120" height="106" fill="rgba(79, 163, 255,0.05)" stroke="#4FA3FF" stroke-width="1.5"/>
              <text x="300" y="80" font-family="JetBrains Mono" font-size="9" fill="#4FA3FF" letter-spacing="1.5" text-anchor="middle">SIGNING CORE</text>
              <line x1="270" y1="86" x2="330" y2="86" stroke="#4FA3FF" opacity="0.6"/>
              <text x="300" y="106" font-family="Space Grotesk" font-size="14" fill="#FFFFFF" font-weight="600" text-anchor="middle">I_priv_n</text>
              <text x="300" y="124" font-family="JetBrains Mono" font-size="9" fill="#8A8F9A" text-anchor="middle">secp256k1</text>
              <text x="300" y="138" font-family="JetBrains Mono" font-size="9" fill="#8A8F9A" text-anchor="middle">libsecp256k1</text>
              <text x="300" y="158" font-family="JetBrains Mono" font-size="8" fill="#4FA3FF" text-anchor="middle">CONST-TIME</text>
              <!-- decorative trace lines -->
              <path d="M222 80 H240 M222 104 H240 M222 128 H240 M222 152 H240" stroke="#4FA3FF" stroke-opacity="0.3"/>
              <path d="M360 80 H378 M360 104 H378 M360 128 H378 M360 152 H378" stroke="#4FA3FF" stroke-opacity="0.5"/>
            </g>

            <!-- right block: attestation -->
            <g>
              <rect x="378" y="46" width="160" height="54" fill="none" stroke="#2C3038" stroke-width="1"/>
              <text x="386" y="62" font-family="JetBrains Mono" font-size="9" fill="#4FA3FF" letter-spacing="1">ATTESTATION</text>
              <line x1="386" y1="68" x2="476" y2="68" stroke="#4FA3FF"/>
              <text x="386" y="82" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A">Cloud attestation</text>
              <text x="386" y="93" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A">RS256 · per-response</text>

              <rect x="378" y="110" width="160" height="54" fill="none" stroke="#2C3038" stroke-width="1"/>
              <text x="386" y="126" font-family="JetBrains Mono" font-size="9" fill="#4FA3FF" letter-spacing="1">KEY BINDING</text>
              <line x1="386" y1="132" x2="476" y2="132" stroke="#4FA3FF"/>
              <text x="386" y="146" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A">hash(I_pub_n) bound</text>
              <text x="386" y="157" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A">binds identity to image</text>
            </g>

            <!-- bottom label -->
            <text x="300" y="190" font-family="JetBrains Mono" font-size="8" fill="#54585F" text-anchor="middle" letter-spacing="2">D_image · sha256:7f3c8b2e4f1a · POLYMER · v2.0</text>
          </svg>
        </div>
      </div>

      <!-- Right side meta rows -->
      <div class="die-side">
        <div class="row">
          <div class="lbl">Output</div>
          <div class="val">PolymerResponse <span class="a">·</span> EIP-712</div>
          <div class="sub">TEE-secured RPC response · typed-data digest</div>
        </div>
        <div class="row">
          <div class="lbl">Signature</div>
          <div class="val">σ = <span class="a">ECDSA-secp256k1</span>(I_priv_n, digest)</div>
          <div class="sub">key generated &amp; sealed inside the enclave · never exfiltrable</div>
        </div>
        <div class="row">
          <div class="lbl">Verifies in</div>
          <div class="val">any <span class="a">EIP-712</span> wallet <span class="a">·</span> Solidity ECDSA.recover <span class="a">·</span> verifier-v2</div>
          <div class="sub">no bespoke library · no protocol-wide setup · no shared key</div>
        </div>
      </div>

    </div>
  </div>

</section>

<!-- ============ INCIDENT ============ -->
<section class="section" id="attack">
  <div class="marker">02 // THE HIDDEN ATTACK SURFACE</div>
  <h2 class="stitle">
    You don't read the blockchain. <span class="dim">A server does.</span>
  </h2>
  <p class="ssub">
    Wallets, bridges, exchanges. Every app on chain depends on someone
    else's server to fetch on-chain data. If that server lies, the lie
    looks identical to the truth.
  </p>

  <!-- Forensic exploit visualization -->
  <div class="exploit">
    <div class="exploit-head">
      <span class="sev">CRITICAL</span>
      <span class="id">kelp.layerzero.node-swap</span>
      <span class="ts">2026-04-18T11:14:23Z</span>
      <span class="attr">attribution: Lazarus Group (DPRK)</span>
    </div>

    <div class="exploit-grid">

      <!-- LEFT: forensic visualization -->
      <div class="exploit-vis">
        <div class="caption">// Forensic · binary diff at T+0</div>

        <div class="swap">
          <div class="swap-node honest">
            <div class="hd"><span>NODE · PUBLIC</span><span class="dot"></span></div>
            <div class="label">canonical RPC node</div>
            <div class="hash">sha256:<br/>9f2c…e4a8</div>
            <div class="delta"><span class="k">behavior:</span> <span class="v">forwards</span></div>
          </div>
          <div class="swap-arrow">
            <span class="glyph">→</span>
            <span class="lbl">FORWARDS</span>
          </div>
          <div class="swap-node swapped">
            <div class="hd"><span>NODE · UPSTREAM</span><span class="dot"></span></div>
            <div class="label">tampered RPC node</div>
            <div class="hash">sha256:<br/>71b3…d92c</div>
            <div class="delta"><span class="k">behavior:</span> <span class="v">selective lie</span></div>
          </div>
        </div>

        <div class="selective">
          <div class="row honest">
            <div class="who">// SAME ENDPOINT → OTHER CLIENTS</div>
            <div class="resp">eth_getProof → valid Merkle proof</div>
          </div>
          <div class="row lied">
            <div class="who">// SAME ENDPOINT → LZ VERIFIER</div>
            <div class="resp">eth_getProof → forged Merkle proof</div>
          </div>
        </div>
      </div>

      <!-- RIGHT: loss + timeline -->
      <div class="exploit-loss">
        <div>
          <span class="single">Drained in a single exploit</span>
          <div class="num"><small>$</small>292<small>M</small></div>
          <div class="num-lbl">Bridge withdrawal · LayerZero rsETH</div>
          <div class="scoped"><strong>116,500 rsETH</strong> · ~18% of circulating supply.</div>
        </div>

        <div class="timeline">
          <div class="tl-lbl">// Window</div>
          <div class="tl-rail">
            <div class="seg" style="left:18%; width:64%;"></div>
            <div class="tl-marks">
              <div class="m" style="left:0%;"><span class="cap">T−5m · DDoS</span></div>
              <div class="m hot" style="left:18%;"><span class="cap">T+0 · swap</span></div>
              <div class="m hot" style="left:50%;"><span class="cap">T+19 · forge</span></div>
              <div class="m hot" style="left:82%;"><span class="cap">T+47 · drain</span></div>
            </div>
          </div>
          <div class="tl-bottom">
            <span>UTC 2026-04-18 11:14</span>
            <span class="duration">47 min · 0 alerts</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ============ ARCHITECTURE ============ -->
<section class="section" id="request">
  <div class="marker">03 // REQUEST FLOW</div>
  <h2 class="stitle">
    From <span class="blue">RPC call</span> to <span class="dim">verified response.</span>
  </h2>
  <p class="ssub">
    A consumer sends an RPC call. The node answers from inside a hardware
    enclave, signs the response, and attaches a fresh attestation. The
    consumer verifies everything against keys pinned on chain.
  </p>

  <div class="arch">
    <div class="arch-head">
      <span class="pill">FIG · 04</span>
      <span class="title">Per-request path · consumer to chain full node to registry</span>
      <span class="right">
        <span>━━ data</span>
        <span style="color:var(--accent)">━━ signed</span>
        <span style="color:var(--fg-2)">┄┄ attested</span>
      </span>
    </div>
    <div class="arch-body">
      <!-- Mobile-only: vertical step diagram -->
      <div class="arch-mobile">
        <div class="am-step am-off">
          <div class="am-lane">// OFF-CHAIN</div>
          <div class="am-card">
            <div class="am-tag">CONSUMER</div>
            <div class="am-name">wallet · indexer · bridge · DVN</div>
            <div class="am-meta">verifier-v2</div>
          </div>
        </div>
        <div class="am-edge">
          <div class="am-edge-line"></div>
          <div class="am-edge-lbl">eth_getBalance(...) <span class="am-dim">· x402 stablecoin</span></div>
        </div>
        <div class="am-step am-off">
          <div class="am-card am-host">
            <div class="am-tag am-tag-dim">HOST · OPERATOR-CONTROLLED</div>
            <div class="am-enclave">
              <div class="am-tag am-blue">TDX ENCLAVE <span class="am-meta-r">D_image ✓</span></div>
              <div class="am-row">
                <div class="am-row-name">Chain Full Node · RPC</div>
                <div class="am-row-meta">EL.eth_getBalance() → resultHash · headBlock · finality</div>
              </div>
              <div class="am-row am-blue-row">
                <div class="am-row-tag">SIGNING IDENTITY</div>
                <div class="am-row-name">I_priv_n</div>
                <div class="am-row-meta">secp256k1 · const-time</div>
              </div>
              <div class="am-row">
                <div class="am-row-tag am-blue">RUNTIME ATTESTATION</div>
                <div class="am-row-name">A_live</div>
                <div class="am-row-meta">Cloud attestation · per-response</div>
              </div>
            </div>
            <div class="am-meta am-host-foot">root @ host = drop, throttle, isolate · cannot reach inside</div>
          </div>
        </div>
        <div class="am-edge am-edge-signed">
          <div class="am-edge-line"></div>
          <div class="am-edge-lbl am-blue">σ · A_live <span class="am-dim">· EIP-712 PolymerResponse</span></div>
        </div>
        <div class="am-step am-on">
          <div class="am-lane">// ON-CHAIN</div>
          <div class="am-card">
            <div class="am-tag am-blue">ON-CHAIN</div>
            <div class="am-name">Registry</div>
            <div class="am-meta">getNodes(1) · ChainVersionRecord</div>
            <div class="am-meta am-dim">D_image · governance</div>
          </div>
        </div>
      </div>
      <svg class="arch-desktop" viewBox="0 0 1280 460" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <marker id="ar3" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#54585F"/>
          </marker>
          <marker id="ar3b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#4FA3FF"/>
          </marker>
          <radialGradient id="enclaveCore" cx="0.5" cy="0.5">
            <stop offset="0%" stop-color="#4FA3FF" stop-opacity="0.15"/>
            <stop offset="100%" stop-color="#4FA3FF" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="silv2" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#F1F4F9"/>
            <stop offset="100%" stop-color="#6F7682"/>
          </linearGradient>
          <linearGradient id="scanGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%"  stop-color="#4FA3FF" stop-opacity="0"/>
            <stop offset="50%" stop-color="#7AA8FF" stop-opacity="0.55"/>
            <stop offset="100%" stop-color="#4FA3FF" stop-opacity="0"/>
          </linearGradient>
          <clipPath id="enclaveClip">
            <rect x="2" y="2" width="440" height="180" rx="5"/>
          </clipPath>
        </defs>

        <!-- swimlane labels -->
        <text x="0" y="20" font-family="JetBrains Mono" font-size="10" fill="#54585F" letter-spacing="1.5">// OFF-CHAIN</text>
        <text x="0" y="408" font-family="JetBrains Mono" font-size="10" fill="#54585F" letter-spacing="1.5">// ON-CHAIN</text>
        <line x1="0" y1="380" x2="1280" y2="380" stroke="#1E2128" stroke-dasharray="2 4"/>

        <!-- consumer -->
        <g transform="translate(40,160)">
          <rect width="200" height="120" rx="6" fill="#0B0C10" stroke="#2C3038"/>
          <text x="16" y="24" font-family="JetBrains Mono" font-size="10" fill="#4FA3FF" letter-spacing="1.5">CONSUMER</text>
          <line x1="16" y1="32" x2="76" y2="32" stroke="#4FA3FF" stroke-opacity="0.6"/>
          <text x="16" y="58" font-family="Space Grotesk" font-size="15" fill="#FFFFFF" font-weight="600">wallet · indexer</text>
          <text x="16" y="78" font-family="Space Grotesk" font-size="15" fill="#FFFFFF" font-weight="600">bridge · DVN</text>
          <text x="16" y="104" font-family="JetBrains Mono" font-size="10" fill="#8A8F9A">verifier-v2</text>
        </g>

        <!-- request -->
        <line class="flow-line" x1="245" y1="220" x2="425" y2="220" stroke="#7A828F" stroke-width="1" marker-end="url(#ar3)"/>
        <text x="335" y="212" font-family="JetBrains Mono" font-size="10" fill="#8A8F9A" text-anchor="middle">eth_getBalance(...)</text>
        <text x="335" y="238" font-family="JetBrains Mono" font-size="9" fill="#54585F" text-anchor="middle">x402 stablecoin</text>

        <!-- HOST + ENCLAVE -->
        <g transform="translate(430,90)">
          <!-- host -->
          <rect width="500" height="260" rx="6" fill="rgba(11,12,16,0.5)" stroke="#2C3038" stroke-dasharray="3 3"/>
          <text x="16" y="22" font-family="JetBrains Mono" font-size="10" fill="#54585F" letter-spacing="1.5">HOST · OPERATOR-CONTROLLED</text>
          <text x="16" y="246" font-family="JetBrains Mono" font-size="9" fill="#54585F">root @ host = drop, throttle, isolate · cannot reach inside</text>

          <!-- enclave (silicon-style) -->
          <g transform="translate(28,42)">
            <rect class="enclave-plate" width="444" height="184" rx="6" fill="url(#silv2)"/>
            <rect x="2" y="2" width="440" height="180" rx="5" fill="#0A0D14" stroke="#4FA3FF" stroke-width="1.5"/>
            <ellipse class="enclave-core-glow" cx="222" cy="92" rx="180" ry="80" fill="url(#enclaveCore)"/>

            <!-- scanning shimmer line -->
            <g clip-path="url(#enclaveClip)">
              <rect class="enclave-scan" x="-30" y="4" width="30" height="176" fill="url(#scanGrad)" opacity="0.85"/>
            </g>

            <!-- pin lights along bottom edge -->
            <g>
              <circle class="pin-light" cx="60"  cy="176" r="1.6" fill="#4FA3FF"/>
              <circle class="pin-light" cx="130" cy="176" r="1.6" fill="#4FA3FF"/>
              <circle class="pin-light" cx="200" cy="176" r="1.6" fill="#4FA3FF"/>
              <circle class="pin-light" cx="270" cy="176" r="1.6" fill="#4FA3FF"/>
              <circle class="pin-light" cx="340" cy="176" r="1.6" fill="#4FA3FF"/>
              <circle class="pin-light" cx="400" cy="176" r="1.6" fill="#4FA3FF"/>
            </g>

            <text x="16" y="22" font-family="JetBrains Mono" font-size="10" fill="#4FA3FF" letter-spacing="1.5">TDX ENCLAVE</text>
            <text x="428" y="22" font-family="JetBrains Mono" font-size="10" fill="#4FA3FF" text-anchor="end" letter-spacing="0.5">D_image ✓</text>

            <!-- workload -->
            <rect x="22" y="42" width="400" height="46" rx="3" fill="rgba(79, 163, 255,0.04)" stroke="#2C3038"/>
            <text x="34" y="62" font-family="Space Grotesk" font-size="13" fill="#FFFFFF" font-weight="600">Chain Full Node · RPC</text>
            <text x="34" y="80" font-family="JetBrains Mono" font-size="9" fill="#8A8F9A">EL.eth_getBalance() → resultHash · headBlock · finality</text>

            <!-- I_priv_n  -->
            <rect class="id-block" x="22" y="98" width="194" height="68" rx="3" fill="rgba(79, 163, 255,0.05)" stroke="#4FA3FF"/>
            <text x="34" y="116" font-family="JetBrains Mono" font-size="10" fill="#4FA3FF" letter-spacing="0.5">SIGNING IDENTITY</text>
            <text x="34" y="138" font-family="Space Grotesk" font-size="15" fill="#FFFFFF" font-weight="600">I_priv_n</text>
