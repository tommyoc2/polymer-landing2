---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Polymer — The Verifiable RPC Network"
  description="Every blockchain app trusts a server it can't audit. Polymer fixes that — every response is signed inside tamper-proof hardware and provably correct before your app acts on it."
  currentPage="protocol"
>

<!-- ============ HERO ============ -->
<section class="hero">
  <canvas id="chrome-bg"></canvas>
  <div class="eyebrow">
    <span>POLYMER <span class="v">/ The Verifiable RPC Network</span></span>
  </div>

  <h1 class="htitle">
    <span class="silver">Verifying the</span><br/>
    <span class="blue">Onchain Economy.</span>
  </h1>

  <p class="lede">
    Every wallet, bridge, and exchange relies on a server it doesn't own to
    read the blockchain. That server could return anything — and there's no
    way to tell. Polymer makes every response <strong>provably correct</strong>
    by signing it inside hardware the operator can't touch.
  </p>

  <div class="cta">
    <a class="btn btn-primary" href="#">Read the whitepaper</a>
  </div>

  <hr class="section-divider"/>
  <div class="marker" id="architecture">01 // HOW THE NODE WORKS</div>

  <!-- DIE-SHOT VISUAL -->
  <div class="die">
    <div class="die-frame">

      <!-- Left side meta rows -->
      <div class="die-side">
        <div class="row">
          <div class="lbl">Hardware</div>
          <div class="val">Intel TDX <span class="a">·</span> sealed RAM</div>
        </div>
        <div class="row">
          <div class="lbl">Software fingerprint</div>
          <div class="val">sha256:<span class="a">7f3c8b…d92c</span></div>
        </div>
        <div class="row live">
          <div class="lbl">Signing key</div>
          <div class="val">unique per node <span class="a">·</span> never leaves hardware</div>
        </div>
        <div class="row">
          <div class="lbl">Lifetime</div>
          <div class="val">memory-only · gone on reboot</div>
        </div>
      </div>

      <!-- Center: chip die -->
      <div class="die-chip">
        <div class="chip-grid"></div>
        <div class="chip-rim"></div>
        <span class="corner tl"></span>
        <span class="corner tr"></span>
        <span class="corner bl"></span>
        <span class="corner br"></span>

        <div class="die-chip-label">
          <span class="tag">TAMPER-PROOF HARDWARE ENCLAVE · sealed by Intel TDX</span>
          <span class="id">node:0x4a8f2c1b…e92c</span>
        </div>

        <div class="die-svg-wrap">
          <svg viewBox="0 0 600 230" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="silver" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#F1F4F9"/>
                <stop offset="50%" stop-color="#B3B9C2"/>
                <stop offset="100%" stop-color="#6F7682"/>
              </linearGradient>
              <linearGradient id="diegrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#1A1F2A"/>
                <stop offset="100%" stop-color="#0A0D14"/>
              </linearGradient>
              <radialGradient id="core" cx="0.5" cy="0.5">
                <stop offset="0%" stop-color="#4FA3FF" stop-opacity="0.45"/>
                <stop offset="100%" stop-color="#4FA3FF" stop-opacity="0"/>
              </radialGradient>
              <marker id="chipArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                <path d="M 0 0 L 10 5 L 0 10 z" fill="#4FA3FF" opacity="0.7"/>
              </marker>
            </defs>

            <!-- Outer chip body -->
            <rect x="10" y="10" width="580" height="210" rx="6" fill="url(#silver)" opacity="0.15"/>
            <rect x="12" y="12" width="576" height="206" rx="5" fill="url(#diegrad)" stroke="#4FA3FF" stroke-opacity="0.6"/>

            <!-- Pin grid top -->
            <g class="pin-row pin-top" fill="#4FA3FF">
              <circle cx="60"  cy="6" r="2"/><circle cx="90"  cy="6" r="2"/><circle cx="120" cy="6" r="2"/>
              <circle cx="160" cy="6" r="2"/><circle cx="200" cy="6" r="2"/><circle cx="240" cy="6" r="2"/>
              <circle cx="300" cy="6" r="2"/>
              <circle cx="360" cy="6" r="2"/><circle cx="400" cy="6" r="2"/><circle cx="440" cy="6" r="2"/>
              <circle cx="480" cy="6" r="2"/><circle cx="510" cy="6" r="2"/><circle cx="540" cy="6" r="2"/>
            </g>
            <g class="pin-row pin-bot" fill="#4FA3FF">
              <circle cx="60"  cy="224" r="2"/><circle cx="90"  cy="224" r="2"/><circle cx="120" cy="224" r="2"/>
              <circle cx="160" cy="224" r="2"/><circle cx="200" cy="224" r="2"/><circle cx="240" cy="224" r="2"/>
              <circle cx="300" cy="224" r="2"/>
              <circle cx="360" cy="224" r="2"/><circle cx="400" cy="224" r="2"/><circle cx="440" cy="224" r="2"/>
              <circle cx="480" cy="224" r="2"/><circle cx="510" cy="224" r="2"/><circle cx="540" cy="224" r="2"/>
            </g>

            <!-- Glow behind center -->
            <ellipse cx="300" cy="115" rx="110" ry="85" fill="url(#core)"/>

            <!-- PANEL 1: READ -->
            <rect x="24" y="26" width="172" height="178" rx="4" fill="none" stroke="#2C3038" stroke-width="1"/>
            <text x="110" y="46" font-family="JetBrains Mono" font-size="9" fill="#4FA3FF" letter-spacing="1.5" text-anchor="middle">01 · READ</text>
            <line x1="40" y1="52" x2="180" y2="52" stroke="#4FA3FF" stroke-opacity="0.4"/>
            <text x="110" y="88" font-family="Space Grotesk" font-size="17" fill="#FFFFFF" font-weight="600" text-anchor="middle">Blockchain</text>
            <text x="110" y="110" font-family="Space Grotesk" font-size="17" fill="#FFFFFF" font-weight="600" text-anchor="middle">Node</text>
            <text x="110" y="142" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A" text-anchor="middle">reads canonical</text>
            <text x="110" y="155" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A" text-anchor="middle">chain state</text>
            <text x="110" y="194" font-family="JetBrains Mono" font-size="7.5" fill="#54585F" text-anchor="middle">inside the enclave</text>

            <!-- Arrow 1→2 -->
            <line x1="196" y1="115" x2="214" y2="115" stroke="#4FA3FF" stroke-opacity="0.6" marker-end="url(#chipArrow)"/>

            <!-- PANEL 2: SIGN (highlighted) -->
            <rect x="216" y="16" width="168" height="198" rx="4" fill="rgba(79, 163, 255,0.07)" stroke="#4FA3FF" stroke-width="1.5"/>
            <text x="300" y="36" font-family="JetBrains Mono" font-size="9" fill="#4FA3FF" letter-spacing="1.5" text-anchor="middle">02 · SIGN</text>
            <line x1="248" y1="42" x2="352" y2="42" stroke="#4FA3FF" stroke-opacity="0.6"/>
            <text x="300" y="80" font-family="Space Grotesk" font-size="17" fill="#FFFFFF" font-weight="600" text-anchor="middle">Signing</text>
            <text x="300" y="102" font-family="Space Grotesk" font-size="17" fill="#FFFFFF" font-weight="600" text-anchor="middle">Key</text>
            <text x="300" y="136" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A" text-anchor="middle">generated in hardware</text>
            <text x="300" y="150" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A" text-anchor="middle">never leaves the enclave</text>
            <text x="300" y="174" font-family="JetBrains Mono" font-size="8" fill="#4FA3FF" text-anchor="middle">SEALED · CONST-TIME</text>
            <text x="300" y="202" font-family="JetBrains Mono" font-size="7.5" fill="#54585F" text-anchor="middle">signs every response</text>

            <!-- Arrow 2→3 -->
            <line x1="384" y1="115" x2="402" y2="115" stroke="#4FA3FF" stroke-width="1.5" stroke-opacity="0.8" marker-end="url(#chipArrow)"/>

            <!-- PANEL 3: PROVE -->
            <rect x="404" y="26" width="172" height="178" rx="4" fill="none" stroke="#2C3038" stroke-width="1"/>
            <text x="490" y="46" font-family="JetBrains Mono" font-size="9" fill="#4FA3FF" letter-spacing="1.5" text-anchor="middle">03 · PROVE</text>
            <line x1="420" y1="52" x2="560" y2="52" stroke="#4FA3FF" stroke-opacity="0.4"/>
            <text x="490" y="88" font-family="Space Grotesk" font-size="17" fill="#FFFFFF" font-weight="600" text-anchor="middle">Hardware</text>
            <text x="490" y="110" font-family="Space Grotesk" font-size="17" fill="#FFFFFF" font-weight="600" text-anchor="middle">Certificate</text>
            <text x="490" y="142" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A" text-anchor="middle">proves correct software</text>
            <text x="490" y="155" font-family="JetBrains Mono" font-size="8" fill="#8A8F9A" text-anchor="middle">is running right now</text>
            <text x="490" y="194" font-family="JetBrains Mono" font-size="7.5" fill="#54585F" text-anchor="middle">refreshed per response</text>

            <!-- Bottom label -->
            <text x="300" y="222" font-family="JetBrains Mono" font-size="7.5" fill="#54585F" text-anchor="middle" letter-spacing="2">POLYMER · TAMPER-PROOF · VERIFIABLE · v2.0</text>
          </svg>
        </div>
      </div>

      <!-- Right side meta rows -->
      <div class="die-side">
        <div class="row">
          <div class="lbl">Output</div>
          <div class="val">signed response <span class="a">·</span> verified format</div>
          <div class="sub">every answer carries a cryptographic signature from inside the enclave</div>
        </div>
        <div class="row">
          <div class="lbl">Signature</div>
          <div class="val">every response <span class="a">cryptographically signed</span> by the node</div>
          <div class="sub">key generated &amp; sealed inside the enclave · never extractable</div>
        </div>
        <div class="row">
          <div class="lbl">Verifies in</div>
          <div class="val">any wallet <span class="a">·</span> on-chain <span class="a">·</span> in your app</div>
          <div class="sub">no custom library · no shared key · no trust in the operator</div>
        </div>
      </div>

    </div>
  </div>

</section>

<!-- ============ INCIDENT ============ -->
<section class="section" id="attack">
  <div class="marker">02 // THE PROBLEM</div>
  <h2 class="stitle">
    You don't read the blockchain. <span class="dim">A server does.</span>
  </h2>
  <p class="ssub">
    Every wallet, bridge, and exchange depends on a server it doesn't control
    to fetch on-chain data. TLS secures the connection — it says nothing about
    whether the answer is true. If the server lies, the lie is indistinguishable
    from the truth.
  </p>

  <!-- Forensic exploit visualization -->
  <div class="exploit">
    <div class="exploit-head">
      <span class="sev">CRITICAL</span>
      <span class="id">kelp.layerzero.node-swap</span>
      <span class="ts">2026-04-18T11:14:23Z</span>
      <span class="attr">attribution: Lazarus Group (DPRK)</span>
    </div>

    <div class="exploit-grid">

      <!-- LEFT: forensic visualization -->
      <div class="exploit-vis">
        <div class="caption">// What happened · April 18, 2026</div>

        <div class="swap">
          <div class="swap-node honest">
            <div class="hd"><span>NODE · PUBLIC</span><span class="dot"></span></div>
            <div class="label">canonical RPC node</div>
            <div class="hash">sha256:<br/>9f2c…e4a8</div>
            <div class="delta"><span class="k">behavior:</span> <span class="v">forwards</span></div>
          </div>
          <div class="swap-arrow">
            <span class="glyph">→</span>
            <span class="lbl">FORWARDS</span>
          </div>
          <div class="swap-node swapped">
            <div class="hd"><span>NODE · UPSTREAM</span><span class="dot"></span></div>
            <div class="label">tampered RPC node</div>
            <div class="hash">sha256:<br/>71b3…d92c</div>
            <div class="delta"><span class="k">behavior:</span> <span class="v">selective lie</span></div>
          </div>
        </div>

        <div class="selective">
          <div class="row honest">
            <div class="who">// SAME SERVER → EVERYONE ELSE</div>
            <div class="resp">returned correct data</div>
          </div>
          <div class="row lied">
            <div class="who">// SAME SERVER → LAYERZERO VERIFIER</div>
            <div class="resp">returned forged data</div>
          </div>
        </div>

        <div style="margin-top:16px; border:1px solid rgba(79,163,255,0.35); border-left:2px solid var(--accent); border-radius:4px; padding:12px 14px; background:rgba(79,163,255,0.04);">
          <div style="font-family:var(--mono); font-size:9.5px; color:var(--accent); letter-spacing:0.12em; margin-bottom:5px;">// WITH POLYMER → THIS ATTACK FAILS</div>
          <div style="font-family:var(--mono); font-size:10.5px; color:var(--fg-1); line-height:1.5;">Swapped binary gets a different hardware fingerprint. The Registry rejects it. The node can't produce a verifiable signature. The attack stops before it starts.</div>
        </div>
      </div>

      <!-- RIGHT: loss + timeline -->
      <div class="exploit-loss">
        <div>
          <span class="single">Drained in a single exploit</span>
          <div class="num"><small>$</small>292<small>M</small></div>
          <div class="num-lbl">Bridge withdrawal · LayerZero rsETH</div>
          <div class="scoped"><strong>116,500 rsETH</strong> · ~18% of circulating supply.</div>
        </div>

        <div class="timeline">
          <div class="tl-lbl">// Window</div>
          <div class="tl-rail">
            <div class="seg" style="left:18%; width:64%;"></div>
            <div class="tl-marks">
              <div class="m" style="left:0%;"><span class="cap">T−5m · DDoS</span></div>
              <div class="m hot" style="left:18%;"><span class="cap">T+0 · swap</span></div>
              <div class="m hot" style="left:50%;"><span class="cap">T+19 · forge</span></div>
              <div class="m hot" style="left:82%;"><span class="cap">T+47 · drain</span></div>
            </div>
          </div>
          <div class="tl-bottom">
            <span>UTC 2026-04-18 11:14</span>
            <span class="duration">47 min · 0 alerts</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ============ ARCHITECTURE ============ -->
<section class="section" id="request">
  <div class="marker">03 // HOW IT WORKS</div>
  <h2 class="stitle">
    From <span class="blue">question</span> to <span class="dim">verified answer.</span>
  </h2>
  <p class="ssub">
    You ask for a balance, a transaction, or an event. The node answers from
    inside a sealed hardware enclave, signs the response, and proves in real
    time that it's running the correct software. Your app checks the signature
    before acting on the data — and can reject anything that doesn't verify.
  </p>

  <div class="arch">
    <div class="arch-head">
      <span class="pill">FIG · 04</span>
      <span class="title">How a request becomes a verified answer</span>
      <span class="right">
        <span>━━ data</span>
        <span style="color:var(--accent)">━━ signed</span>
        <span style="color:var(--fg-2)">┄┄ attested</span>
      </span>
    </div>
    <div class="arch-body">
      <!-- Mobile-only: vertical step diagram -->
      <div class="arch-mobile">
        <div class="am-step am-off">
          <div class="am-lane">// OFF-CHAIN</div>
          <div class="am-card">
            <div class="am-tag">CONSUMER</div>
            <div class="am-name">wallet · indexer · bridge · DVN</div>
            <div class="am-meta">signature check</div>
          </div>
        </div>
        <div class="am-edge">
          <div class="am-edge-line"></div>
          <div class="am-edge-lbl">your request <span class="am-dim">· pay per call</span></div>
        </div>
        <div class="am-step am-off">
          <div class="am-card am-host">
            <div class="am-tag am-tag-dim">HOST · OPERATOR-CONTROLLED</div>
            <div class="am-enclave">
              <div class="am-tag am-blue">HARDWARE ENCLAVE <span class="am-meta-r">software verified ✓</span></div>
              <div class="am-row">
                <div class="am-row-name">Blockchain Node · RPC</div>
                <div class="am-row-meta">reads chain state → signs the answer</div>
              </div>
              <div class="am-row am-blue-row">
                <div class="am-row-tag">SIGNING KEY</div>
                <div class="am-row-name">unique per node</div>
                <div class="am-row-meta">sealed in hardware · never leaves</div>
              </div>
              <div class="am-row">
                <div class="am-row-tag am-blue">LIVE PROOF</div>
                <div class="am-row-name">hardware certificate</div>
                <div class="am-row-meta">proves correct software is running right now</div>
              </div>
            </div>
            <div class="am-meta am-host-foot">the operator can drop or throttle · they cannot alter what the node says</div>
          </div>
        </div>
        <div class="am-edge am-edge-signed">
          <div class="am-edge-line"></div>
          <div class="am-edge-lbl am-blue">signed response <span class="am-dim">· live hardware proof</span></div>
        </div>
        <div class="am-step am-on">
          <div class="am-lane">// ON-CHAIN</div>
          <div class="am-card">
            <div class="am-tag am-blue">ON-CHAIN</div>
            <div class="am-name">Registry</div>
            <div class="am-meta">approved node keys · on-chain</div>
            <div class="am-meta am-dim">approved software versions · governance</div>
          </div>
        </div>
      </div>
      <svg class="arch-desktop" viewBox="0 0 1280 460" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <marker id="ar3" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#54585F"/>
          </marker>
          <marker id="ar3b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#4FA3FF"/>
          </marker>
          <radialGradient id="enclaveCore" cx="0.5" cy="0.5">
            <stop offset="0%" stop-color="#4FA3FF" stop-opacity="0.15"/>
            <stop offset="100%" stop-color="#4FA3FF" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="silv2" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#F1F4F9"/>
            <stop offset="100%" stop-color="#6F7682"/>
          </linearGradient>
          <linearGradient id="scanGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%"  stop-color="#4FA3FF" stop-opacity="0"/>
            <stop offset="50%" stop-color="#7AA8FF" stop-opacity="0.55"/>
            <stop offset="100%" stop-color="#4FA3FF" stop-opacity="0"/>
          </linearGradient>
          <clipPath id="enclaveClip">
            <rect x="2" y="2" width="440" height="180" rx="5"/>
          </clipPath>
        </defs>

        <!-- swimlane labels -->
        <text x="0" y="20" font-family="JetBrains Mono" font-size="10" fill="#54585F" letter-spacing="1.5">// OFF-CHAIN</text>
        <text x="0" y="408" font-family="JetBrains Mono" font-size="10" fill="#54585F" letter-spacing="1.5">// ON-CHAIN</text>
        <line x1="0" y1="380" x2="1280" y2="380" stroke="#1E2128" stroke-dasharray="2 4"/>

        <!-- consumer -->
        <g transform="translate(40,160)">
          <rect width="200" height="120" rx="6" fill="#0B0C10" stroke="#2C3038"/>
          <text x="16" y="24" font-family="JetBrains Mono" font-size="10" fill="#4FA3FF" letter-spacing="1.5">CONSUMER</text>
          <line x1="16" y1="32" x2="76" y2="32" stroke="#4FA3FF" stroke-opacity="0.6"/>
          <text x="16" y="58" font-family="Space Grotesk" font-size="15" fill="#FFFFFF" font-weight="600">wallet · indexer</text>
          <text x="16" y="78" font-family="Space Grotesk" font-size="15" fill="#FFFFFF" font-weight="600">bridge · DVN</text>
          <text x="16" y="104" font-family="JetBrains Mono" font-size="10" fill="#8A8F9A">signature check</text>
        </g>

        <!-- request -->
        <line class="flow-line" x1="245" y1="220" x2="425" y2="220" stroke="#7A828F" stroke-width="1" marker-end="url(#ar3)"/>
        <text x="335" y="212" font-family="JetBrains Mono" font-size="10" fill="#8A8F9A" text-anchor="middle">eth_getBalance(...)</text>
        <text x="335" y="238" font-family="JetBrains Mono" font-size="9" fill="#54585F" text-anchor="middle">x402 stablecoin</text>

        <!-- HOST + ENCLAVE -->
        <g transform="translate(430,90)">
          <!-- host -->
          <rect width="500" height="260" rx="6" fill="rgba(11,12,16,0.5)" stroke="#2C3038" stroke-dasharray="3 3"/>
          <text x="16" y="22" font-family="JetBrains Mono" font-size="10" fill="#54585F" letter-spacing="1.5">HOST · OPERATOR-CONTROLLED</text>
          <text x="16" y="246" font-family="JetBrains Mono" font-size="9" fill="#54585F">operator can drop or throttle · cannot alter what the node says</text>

          <!-- enclave (silicon-style) -->
          <g transform="translate(28,42)">
            <rect class="enclave-plate" width="444" height="184" rx="6" fill="url(#silv2)"/>
            <rect x="2" y="2" width="440" height="180" rx="5" fill="#0A0D14" stroke="#4FA3FF" stroke-width="1.5"/>
            <ellipse class="enclave-core-glow" cx="222" cy="92" rx="180" ry="80" fill="url(#enclaveCore)"/>

            <!-- scanning shimmer line -->
            <g clip-path="url(#enclaveClip)">
              <rect class="enclave-scan" x="-30" y="4" width="30" height="176" fill="url(#scanGrad)" opacity="0.85"/>
            </g>

            <!-- pin lights along bottom edge -->
            <g>
              <circle class="pin-light" cx="60"  cy="176" r="1.6" fill="#4FA3FF"/>
              <circle class="pin-light" cx="130" cy="176" r="1.6" fill="#4FA3FF"/>
              <circle class="pin-light" cx="200" cy="176" r="1.6" fill="#4FA3FF"/>
              <circle class="pin-light" cx="270" cy="176" r="1.6" fill="#4FA3FF"/>
              <circle class="pin-light" cx="340" cy="176" r="1.6" fill="#4FA3FF"/>
              <circle class="pin-light" cx="400" cy="176" r="1.6" fill="#4FA3FF"/>
            </g>

            <text x="16" y="22" font-family="JetBrains Mono" font-size="10" fill="#4FA3FF" letter-spacing="1.5">TDX ENCLAVE</text>
            <text x="428" y="22" font-family="JetBrains Mono" font-size="10" fill="#4FA3FF" text-anchor="end" letter-spacing="0.5">D_image ✓</text>

            <!-- workload -->
            <rect x="22" y="42" width="400" height="46" rx="3" fill="rgba(79, 163, 255,0.04)" stroke="#2C3038"/>
            <text x="34" y="62" font-family="Space Grotesk" font-size="13" fill="#FFFFFF" font-weight="600">Chain Full Node · RPC</text>
            <text x="34" y="80" font-family="JetBrains Mono" font-size="9" fill="#8A8F9A">EL.eth_getBalance() → resultHash · headBlock · finality</text>

            <!-- I_priv_n  -->
