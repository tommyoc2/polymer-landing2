  </div>
</section>

</BaseLayout>

<style>
/* ─── TRUST GAP ─── */
.trust-gap {
  display: flex;
  align-items: center;
  gap: 0;
  margin: 48px 0 28px;
  overflow-x: auto;
}
.tg-node { flex: 0 0 auto; position: relative; }
.tg-box {
  border: 1px solid #2C3038;
  border-radius: 6px;
  padding: 22px 26px;
  min-width: 190px;
  background: #0B0C10;
  position: relative;
  transition: border-color 0.3s;
}
.tg-box:hover { border-color: rgba(79,163,255,0.4); }
.tg-tag {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.14em;
  color: var(--accent);
  margin-bottom: 8px;
}
.tg-tag-warn { color: #FF6060; }
.tg-name {
  font-family: var(--sans);
  font-size: 14px;
  font-weight: 600;
  color: var(--fg-1);
  margin-bottom: 4px;
}
.tg-detail {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--fg-3);
}
.tg-warn-lbl {
  font-family: var(--mono);
  font-size: 10px;
  color: #FF6060;
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid rgba(255,80,80,0.2);
}
.tg-node-warn { position: relative; }
.tg-warn-ring {
  position: absolute;
  inset: -4px;
  border-radius: 10px;
  border: 1px solid rgba(255,80,80,0.35);
  animation: pulse-warn 2.5s ease-in-out infinite;
  pointer-events: none;
}
@keyframes pulse-warn {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.015); }
}
.tg-box-warn {
  border-color: rgba(255,80,80,0.4);
  background: rgba(255,30,30,0.04);
}
.tg-conn {
  flex: 1 1 auto;
  min-width: 80px;
  padding: 0 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}
.tg-conn-track {
  width: 100%;
  height: 2px;
  background: #1A1F2A;
  border-radius: 2px;
  overflow: hidden;
  position: relative;
}
.tg-conn-pulse {
  position: absolute;
  top: 0; left: -40%;
  width: 40%;
  height: 100%;
  background: linear-gradient(to right, transparent, rgba(79,163,255,0.7), transparent);
  animation: slide-pulse 2s linear infinite;
}
@keyframes slide-pulse {
  from { left: -40%; }
  to   { left: 120%; }
}
.tg-conn-cap {
  font-family: var(--mono);
  font-size: 9px;
  color: var(--fg-3);
  white-space: nowrap;
}

/* ─── PROBLEM BULLETS ─── */
.problem-bullets {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 24px 0 36px;
  max-width: 680px;
}
.pb-item {
  display: flex;
  gap: 12px;
  font-family: var(--mono);
  font-size: 12px;
  color: var(--fg-2);
  line-height: 1.7;
}
.pb-dash { color: var(--accent); flex-shrink: 0; }

/* ─── RESOLUTION BOX ─── */
.resolution-box {
  margin-top: 16px;
  border: 1px solid rgba(79,163,255,0.35);
  border-left: 2px solid var(--accent);
  border-radius: 4px;
  padding: 12px 16px;
  background: rgba(79,163,255,0.04);
}
.rb-label {
  font-family: var(--mono);
  font-size: 9.5px;
  color: var(--accent);
  letter-spacing: 0.12em;
  margin-bottom: 6px;
}
.rb-body {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--fg-1);
  line-height: 1.6;
}

/* ─── BEFORE / AFTER ─── */
.compare {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 0;
  margin: 40px 0 0;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid #2C3038;
}
.compare-col { padding: 28px 28px 32px; }
.compare-before { background: rgba(255,30,30,0.02); }
.compare-after  {
  background: rgba(79,163,255,0.03);
  box-shadow: inset 0 0 60px rgba(79,163,255,0.04);
}
.compare-vs {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 20px;
  border-left: 1px solid #2C3038;
  border-right: 1px solid #2C3038;
  background: #0B0C10;
}
.compare-vs-line {
  flex: 1;
  width: 1px;
  background: linear-gradient(to bottom, transparent, #2C3038, transparent);
}
.compare-vs-label {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--fg-3);
}
.cmp-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 20px;
}
.cmp-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
}
.cmp-dot-bad  { background: #FF4040; box-shadow: 0 0 6px #FF4040; }
.cmp-dot-good { background: #4FA3FF; box-shadow: 0 0 6px #4FA3FF; animation: dot-pulse 2s ease-in-out infinite; }
@keyframes dot-pulse {
  0%, 100% { box-shadow: 0 0 4px #4FA3FF; }
  50%       { box-shadow: 0 0 12px #4FA3FF; }
}
.cmp-label      { font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; color: #FF6060; }
.cmp-label-good { color: var(--accent); }
.cmp-steps { display: flex; flex-direction: column; gap: 0; }
.cmp-step {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--fg-2);
  padding: 10px 14px;
  border: 1px solid #2C3038;
  border-radius: 4px;
  line-height: 1.5;
  background: #0B0C10;
}
.cmp-note { display: block; font-size: 10px; color: var(--fg-3); margin-top: 4px; }
.cmp-arrow { text-align: center; font-family: var(--mono); font-size: 16px; color: var(--fg-3); padding: 4px 0; }
.cmp-arrow-blue { color: var(--accent); }
.cmp-bad  { border-color: rgba(255,80,80,0.3); background: rgba(255,30,30,0.04); }
.cmp-fail { border-color: rgba(255,80,80,0.5); background: rgba(255,30,30,0.06); color: #FF6060; font-weight: 600; }
.cmp-sealed {
  border-color: rgba(79,163,255,0.4);
  background: rgba(79,163,255,0.05);
  position: relative;
  overflow: hidden;
}
.cmp-sealed::after {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%;
  height: 100%;
