</section>

<!-- ============ JOIN ============ -->
<section class="section connect-join">
  <div class="join-card">
    <div class="join-copy">
      <div class="marker">03 // BUILD WITH US</div>
      <h2 class="stitle">
        Help ship <span class="dim">the verifiable RPC network.</span>
      </h2>
      <p class="ssub">
        We're hiring across protocol engineering, infrastructure, and growth.
        Apply directly through LinkedIn.
      </p>
    </div>
    <div class="join-cta">
      <a class="btn btn-primary" href="https://www.linkedin.com/company/polymer-labs/jobs/" target="_blank" rel="noopener">Join now</a>
    </div>
  </div>
</section>

<style>
  .connect-hero {
    padding-bottom: 64px;
  }

  /* ===== Photo stage ===== */
  .connect-stage-wrap {
    padding: 56px 64px 88px;
    border-bottom: 1px solid var(--hairline);
    background:
      radial-gradient(ellipse 900px 500px at 30% 0%, rgba(79,163,255,0.07), transparent 60%),
      radial-gradient(ellipse 700px 400px at 80% 100%, rgba(79,163,255,0.05), transparent 60%);
  }
  .connect-stage-inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .stage-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-3);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .stage-eyebrow .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: glow 1.6s ease-in-out infinite;
  }

  .connect-stage {
    --mx: 0; --my: 0;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    perspective: 1400px;
    transform-style: preserve-3d;
    transform: rotateX(calc(var(--my) * -4deg)) rotateY(calc(var(--mx) * 4deg));
    transition: transform 280ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .cphoto {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    margin: 0;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--bg-1);
    box-shadow:
      0 1px 0 rgba(255,255,255,0.05) inset,
      0 14px 40px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(0, 0, 0, 0.2);
    transform-style: preserve-3d;
    transform: translateZ(var(--z)) rotate(var(--rot));
    filter: brightness(0.82) saturate(0.92);
    transition: transform 360ms cubic-bezier(0.2, 0.6, 0.2, 1),
                filter 360ms ease,
                box-shadow 360ms ease;

    /* Entrance state — overridden when stage gains .is-revealed */
    opacity: 0;
    translate: 0 24px;
    will-change: transform, translate, opacity;
  }
  .cphoto img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  /* Portrait photos display taller */
  .cphoto:nth-child(2) img,
  .cphoto:nth-child(7) img { aspect-ratio: 2 / 3; }
  .cphoto:nth-child(3) img { aspect-ratio: 1 / 1; }
  .cphoto:nth-child(4) img { aspect-ratio: 1 / 1; }
  .cphoto:nth-child(6) img { aspect-ratio: 4 / 3; }
  .cphoto:nth-child(9) img { aspect-ratio: 4 / 3; }

  .connect-stage.is-revealed .cphoto {
    opacity: 1;
    animation:
      enter 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both,
      drift var(--dur) ease-in-out infinite;
    animation-delay: var(--delay), calc(900ms + var(--delay));
  }

  @keyframes enter {
    from {
      opacity: 0;
      translate: 0 32px;
      transform: translateZ(calc(var(--z) - 80px)) rotate(calc(var(--rot) * 1.6));
    }
    to {
      opacity: 1;
      translate: 0 0;
      transform: translateZ(var(--z)) rotate(var(--rot));
    }
  }

  @keyframes drift {
    0%, 100% { translate: 0 0; }
    25%      { translate: 6px -5px; }
    50%      { translate: -3px 7px; }
    75%      { translate: -7px -2px; }
  }

  .cphoto:hover {
    transform: translateZ(70px) rotate(0deg) scale(1.04);
    filter: brightness(1.08) saturate(1.05);
    z-index: 10;
    box-shadow:
      0 1px 0 rgba(255,255,255,0.12) inset,
      0 24px 60px rgba(0, 0, 0, 0.6),
      0 0 0 1px var(--accent-border);
  }

  /* ===== Socials grid ===== */
  .connect-socials .social-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 40px;
  }
  .social-card {
    display: flex; flex-direction: column; gap: 10px;
    padding: 22px 22px 20px;
    background: var(--bg-1);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    text-decoration: none;
    color: var(--fg-1);
    transition: border-color 200ms, background 200ms, transform 200ms;
    position: relative;
    overflow: hidden;
  }
  .social-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 320px 180px at 100% 0%, rgba(79, 163, 255, 0.08), transparent 60%);
    opacity: 0;
    transition: opacity 200ms;
    pointer-events: none;
  }
  .social-card:hover {
    border-color: var(--accent-border);
    background: var(--bg-2);
    transform: translateY(-2px);
  }
  .social-card:hover::before { opacity: 1; }
  .social-row {
    display: flex; align-items: center; gap: 12px;
    position: relative;
  }
  .social-icon {
    width: 22px; height: 22px;
    color: var(--fg-1);
    flex: 0 0 auto;
  }
  .social-card:hover .social-icon { color: var(--accent); }
  .social-name {
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--fg-0);
  }
  .social-arrow {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--fg-3);
    transition: transform 200ms, color 200ms;
  }
  .social-card:hover .social-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  .social-handle {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-3);
    letter-spacing: 0.04em;
  }

  /* ===== Join card ===== */
  .connect-join .join-card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 32px;
    padding: 44px 48px;
    border: 1px solid var(--hairline);
    border-radius: 10px;
    background:
      radial-gradient(ellipse 600px 280px at 0% 50%, rgba(79, 163, 255, 0.07), transparent 60%),
      var(--bg-1);
  }
  .connect-join .join-card .marker { margin-bottom: 14px; }
  .connect-join .join-card .stitle { margin: 0 0 10px; }
  .connect-join .join-card .ssub { margin: 0; max-width: 560px; }
  .connect-join .join-cta { display: flex; align-items: center; }
  .connect-join .join-cta .btn { height: 52px; padding: 0 28px; font-size: 15px; }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .connect-stage-wrap { padding: 48px 40px 72px; }
    .connect-socials .social-grid { grid-template-columns: repeat(2, 1fr); }
    .connect-join .join-card { grid-template-columns: 1fr; }
  }

  @media (max-width: 720px) {
    .connect-stage-wrap { padding: 32px 16px 56px; }
    .connect-stage {
      aspect-ratio: auto;
      height: auto;
      perspective: none;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      transform: none !important;
    }
    .cphoto {
      position: static;
      width: 100% !important;
      transform: rotate(var(--rot));
      animation: none !important;
    }
    .connect-stage.is-revealed .cphoto {
      opacity: 1;
      translate: 0 0;
      animation: none;
    }
    .cphoto:hover { transform: rotate(0); }
    .cphoto img { aspect-ratio: 4 / 3 !important; }

    .connect-join .join-card { padding: 28px 22px; }
    .connect-join .join-cta .btn { width: 100%; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .connect-stage { transition: none; transform: none; }
    .cphoto, .connect-stage.is-revealed .cphoto {
      animation: none !important;
      opacity: 1;
      translate: 0 0;
    }
  }
</style>

<script is:inline>
  (() => {
    const stage = document.getElementById('connect-stage');
    if (!stage) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Reveal entrance once the stage scrolls into view */
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            stage.classList.add('is-revealed');
            io.unobserve(stage);
          }
        }
      }, { threshold: 0.1 });
      io.observe(stage);
    } else {
      stage.classList.add('is-revealed');
    }

    if (reduced || matchMedia('(max-width: 720px)').matches) return;

    /* Mouse parallax — tilt the stage subtly toward the cursor */
    let raf = 0;
    let tx = 0, ty = 0;
    const onMove = (e) => {
      const r = stage.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width  - 0.5) * 2;
      ty = ((e.clientY - r.top)  / r.height - 0.5) * 2;
      if (!raf) raf = requestAnimationFrame(apply);
    };
    const apply = () => {
      raf = 0;
      stage.style.setProperty('--mx', tx.toFixed(3));
      stage.style.setProperty('--my', ty.toFixed(3));
    };
    const onLeave = () => {
      tx = 0; ty = 0;
      apply();
    };
    stage.addEventListener('mousemove', onMove);
    stage.addEventListener('mouseleave', onLeave);
  })();
</script>

</BaseLayout>
