  { src: 'tommy-828x830.webp',           x: '78%', y: '4%',  w: '18%', rot:  2.0, z: -20, dur: 21, delay: 1.0 },
  { src: 'A7C00107-828x568.webp',        x: '6%',  y: '44%', w: '22%', rot:  1.5, z: -10, dur: 24, delay: 2.0 },
  { src: 'IMG_0322-828x621.webp',        x: '34%', y: '40%', w: '26%', rot: -2.2, z:  35, dur: 17, delay: 0.8 },
  { src: 'A7C00203-828x1242.webp',       x: '67%', y: '36%', w: '14%', rot:  2.0, z: -35, dur: 23, delay: 1.2 },
  { src: 'A7C09912-828x552.webp',        x: '12%', y: '74%', w: '20%', rot: -1.0, z: -45, dur: 20, delay: 0.3 },
  { src: 'A7C00280-828x597.webp',        x: '38%', y: '76%', w: '23%', rot:  1.8, z:  0,  dur: 18, delay: 1.8 },
