        </svg>
        <span class="social-name">GitHub</span>
        <span class="social-arrow">↗</span>
      </div>
      <div class="social-handle">polymerdao</div>
    </a>
    <a class="social-card" href="https://discord.com/invite/5UZmbmjG" target="_blank" rel="noopener">
      <div class="social-row">
