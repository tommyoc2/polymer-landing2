---
<BaseLayout
  title="Connect — Polymer"
  description="Be a part of our global community. Polymer is built in the open — chat, ship, and contribute alongside the people building the verifiable RPC network."
  currentPage="connect"
>

<!-- ============ HERO ============ -->
<section class="hero connect-hero">
  <canvas id="chrome-bg"></canvas>
  <div class="eyebrow">
    <span>POLYMER COMMUNITY <span class="v">/ globally distributed</span></span>
  </div>

  <h1 class="htitle">
    <span class="silver">Be part of</span><br/>
    <span class="blue">our community.</span>
  </h1>

  <p class="lede">
    Polymer is built in the open. Wherever you are — chat, ship, contribute,
    or come hang out with the people building the verifiable RPC network.
  </p>

  <div class="cta">
    <a class="btn btn-primary" href="https://www.linkedin.com/company/polymer-labs/jobs/" target="_blank" rel="noopener">Join now</a>
    <a class="btn btn-secondary" href="#follow">Follow the work</a>
  </div>
</section>

<!-- ============ PHOTO STAGE ============ -->
<section class="connect-stage-wrap" aria-label="Polymer community photo wall">
  <div class="connect-stage-inner">
    <div class="stage-eyebrow">
      <span class="dot" aria-hidden="true"></span>
      <span>// IN THE WILD · POLYMER, WORLDWIDE</span>
    </div>
    <div class="connect-stage" id="connect-stage" aria-hidden="true">
      {photos.map((p, i) => (
        <figure
          class="cphoto"
          style={`--x:${p.x};--y:${p.y};--w:${p.w};--rot:${p.rot}deg;--z:${p.z}px;--dur:${p.dur}s;--delay:${p.delay}s;--i:${i};`}
        >
          <img
            src={`/assets/community/${p.src}`}
            alt=""
            loading="lazy"
            decoding="async"
            width="828"
            height="552"
          />
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- ============ FOLLOW THE WORK ============ -->
<section class="section connect-socials" id="follow">
  <div class="marker">02 // FOLLOW THE WORK</div>
  <h2 class="stitle">
    Where the team <span class="dim">hangs out.</span>
  </h2>
  <p class="ssub">
    Pick a venue. We're active in all of them — engineers, researchers,
    and the broader Polyverse.
  </p>

  <div class="social-grid">
    <a class="social-card" href="https://x.com/Polymer_Labs" target="_blank" rel="noopener">
