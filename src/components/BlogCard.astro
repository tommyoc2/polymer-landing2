---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const slug = entry.data.slug ?? entry.id;
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<a class="post-card" href={`/blog/${slug}/`}>
  <div class="media">
    {entry.data.cover && (
      <img src={entry.data.cover} alt={entry.data.title} loading={eager ? 'eager' : 'lazy'} />
    )}
  </div>
  <div class="body">
    <div class="meta-top">
      <span>{fmtDate(entry.data.date)}</span>
      {entry.data.readTime > 0 && (
        <>
          <span class="dot"></span>
          <span>{entry.data.readTime} min</span>
        </>
      )}
    </div>
    <h3>{entry.data.title}</h3>
    <p class="desc">{entry.data.description}</p>
    <div class="meta-bot">
      <span class="author">{entry.data.author}</span>
      <span class="arrow">→</span>
    </div>
  </div>
</a>
