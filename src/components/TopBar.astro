---
import PolymerWordmark from './PolymerWordmark.astro';

interface Props {
  currentPage?: 'protocol' | 'proveapi';
}
const { currentPage = 'protocol' } = Astro.props;
const isProveAPI = currentPage === 'proveapi';
const moreClass = isProveAPI ? 'nav-more has-current' : 'nav-more';
const overviewClass = isProveAPI ? 'nav-current' : '';
---

<header class="topbar">
  <a href="/" class="wm" aria-label="Polymer — home">
    <PolymerWordmark id="topbar" class="wm-logo" />
  </a>
  <button class="menu-btn" type="button" aria-expanded="false" aria-label="Toggle menu" onclick="this.closest('.topbar').classList.toggle('menu-open');this.setAttribute('aria-expanded',this.closest('.topbar').classList.contains('menu-open'))">
    <span class="bars"><span></span><span></span><span></span></span>
    Menu
  </button>
  <nav>
    <a href="/#architecture">Architecture</a>
    <a href="/#attack">Attack Surface</a>
    <a href="/#request">Request Flow</a>
    <a href="/#pillars">Trust Pillars</a>
    <span class="nav-sep" aria-hidden="true"></span>
    <div class={moreClass}>
      <button type="button" class="nav-more-btn" aria-haspopup="true" aria-expanded="false" onclick="this.parentElement.classList.toggle('open');this.setAttribute('aria-expanded',this.parentElement.classList.contains('open'))">
        <span class="label">ProveAPI</span><span class="nav-more-caret" aria-hidden="true">▾</span>
      </button>
      <div class="nav-more-panel" role="menu">
        <a href="/proveapi.html" role="menuitem" class={overviewClass}>Overview</a>
        <a href="https://docs.polymerlabs.org/" target="_blank" rel="noopener" role="menuitem">Docs ↗</a>
        <div class="nav-more-divider"></div>
        <a href="https://accounts.polymerlabs.org/" target="_blank" rel="noopener" role="menuitem">Accounts ↗</a>
        <a href="https://dashboard.polymerlabs.org/analytics" target="_blank" rel="noopener" role="menuitem">Analytics ↗</a>
        <a href="https://dashboard.polymerlabs.org/" target="_blank" rel="noopener" role="menuitem">Explorer ↗</a>
      </div>
    </div>
    <div class="nav-status">
      <span class="live">~$2B volume</span>
    </div>
  </nav>
  <div class="right">
    <span class="live">~$2B volume</span>
  </div>
</header>
